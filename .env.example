GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
HUNTER_API_KEY=
RESEND_API_KEY=
# Must be the email address of your Resend account (free tier only delivers there)
DEMO_EMAIL=
ORGANIZER_TZ=Asia/Kolkata
REPLY_DEADLINE_HOURS=48
# How often the dashboard / run.py --watch checks for threads past the no-reply deadline
DEADLINE_CHECK_MINUTES=10
# Postgres (Neon). When set, the app, worker and Vercel deployment all use it instead of data/sprinto.db
DATABASE_URL=
# Login password for the web app (Vercel and local) and the cookie-signing secret
APP_PASSWORD=
SESSION_SECRET=

# Assignment review: no login on the deployed app (set in Vercel). Leave unset locally to keep the login.
PUBLIC_ACCESS=
